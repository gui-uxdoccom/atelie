# ---- secrets ------------------------------------------------------------
# Real credentials live in .env (local) and Render env vars (prod).
# Only the placeholder template is committed.
.env
.env.*
!.env.example

# Private keys / certs of any kind
*.pem
*.key
*.p12

# Android signing key for the PWABuilder APK (README: "Save the signing key").
# Lose it and you can't update the installed app — but it must NEVER be public.
*.keystore
*.jks
*.apk
*.aab

# ---- dependencies -------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ---- build output -------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- tests --------------------------------------------------------------
coverage/
test-results/
playwright-report/
playwright/.cache/

# ---- logs ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- supabase CLI (if used locally later) --------------------------------
supabase/.branches
supabase/.temp

# ---- editor / OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- tooling ------------------------------------------------------------
.vercel
.claude/settings.local.json
